{
  "format": "firewalker-recipe",
  "version": 2,
  "name": "charon-wake",
  "description": "A dark boot with banked embers. Every footfall breathes out a plume of violet smoke that rolls along both sides, and sound wakes pale sparks.",
  "layers": [
    {
      "type": "fill",
      "label": "Embers",
      "enabled": true,
      "palette": ["#0e0630", "#04061e"],
      "spread": "foot",
      "repeat": 1,
      "offset": 0,
      "scroll": 0.05,
      "brightness": { "source": "audioLevel", "min": 0.6, "max": 1 },
      "blend": "over",
      "opacity": { "source": "wave", "min": 0.55, "max": 1, "periodMs": 5200 }
    },
    {
      "type": "trail",
      "label": "Plume",
      "enabled": true,
      "trigger": "any",
      "from": "down-end",
      "flatZone": 0.3,
      "palette": ["#0c0626", "#8a44ff", "#4a50ff", "#1c1670", "#080620", "#000000"],
      "speed": 40,
      "length": 48,
      "brightness": { "source": "stompStrength", "min": 0.5, "max": 1 },
      "maxFronts": 16,
      "blend": "max",
      "opacity": { "source": "audioLevel", "min": 0.75, "max": 1 }
    },
    {
      "type": "trail",
      "label": "Blue drift",
      "enabled": true,
      "trigger": "any",
      "from": "down-point",
      "flatZone": 0.3,
      "palette": ["#000000", "#2f6bff", "#101c70", "#000000"],
      "speed": 75,
      "length": 22,
      "brightness": { "source": "stompStrength", "min": 0.3, "max": 0.8 },
      "maxFronts": 12,
      "blend": "add",
      "opacity": 0.8
    },
    {
      "type": "sparkle",
      "label": "Souls",
      "enabled": true,
      "palette": ["#b9a8ff", "#7fa4ff"],
      "density": { "source": "audioLevel", "min": 1, "max": 14 },
      "fadeMs": 1300,
      "brightness": 0.45,
      "blend": "add",
      "opacity": 1
    }
  ]
}
