{
  "format": "firewalker-recipe",
  "version": 1,
  "name": "cat-prowl",
  "description": "Bold purple and pink stripes slink around the boot. Lean toe-down to send them forward faster, heel-down to reverse, and every stomp makes the fur twitch.",
  "layers": [
    {
      "type": "fill",
      "label": "Stripes",
      "enabled": true,
      "palette": ["#6a00ff", "#6a00ff", "#6a00ff", "#ff1f8f", "#ff1f8f", "#ff1f8f"],
      "spread": "ring",
      "repeat": 6,
      "offset": { "source": "stompFade", "min": 0, "max": 0.5, "fadeMs": 450 },
      "scroll": { "source": "tilt", "min": -0.8, "max": 1.6 },
      "brightness": { "source": "stompFade", "min": 0.8, "max": 1, "fadeMs": 450 },
      "blend": "over",
      "opacity": 1
    }
  ]
}
