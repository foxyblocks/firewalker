{
  "format": "firewalker-recipe",
  "version": 2,
  "name": "charon-mist",
  "description": "River fog that clings to the boot in drifting violet and blue banks. Tilt pushes it along the foot, each step breathes it brighter, and sound swells it.",
  "layers": [
    {
      "type": "fill",
      "label": "Fog",
      "enabled": true,
      "palette": ["#7018ff", "#12043c", "#0c2ad0", "#030210", "#5010c0", "#06104a"],
      "spread": "foot",
      "repeat": 1,
      "offset": 0,
      "scroll": { "source": "tilt", "min": -0.3, "max": 0.4 },
      "brightness": { "source": "audioLevel", "min": 0.62, "max": 1 },
      "blend": "over",
      "opacity": 1
    },
    {
      "type": "fill",
      "label": "Pale wisps",
      "enabled": true,
      "palette": ["#000000", "#3a3478", "#000000", "#000000", "#1c2460", "#000000"],
      "spread": "foot",
      "repeat": 1.5,
      "offset": 0.3,
      "scroll": { "source": "tilt", "min": -0.55, "max": 0.75 },
      "brightness": 1,
      "blend": "add",
      "opacity": 1
    },
    {
      "type": "fill",
      "label": "Veil",
      "enabled": true,
      "palette": ["#ffffff", "#242424", "#a0a0a0", "#0c0c0c", "#d8d8d8", "#404040"],
      "spread": "ring",
      "repeat": 3,
      "offset": 0,
      "scroll": 0.09,
      "brightness": 1,
      "blend": "multiply",
      "opacity": 1
    },
    {
      "type": "fill",
      "label": "Counter veil",
      "enabled": true,
      "palette": ["#ffffff", "#606060", "#e8e8e8", "#303030"],
      "spread": "ring",
      "repeat": 2,
      "offset": 0,
      "scroll": -0.07,
      "brightness": 1,
      "blend": "multiply",
      "opacity": 0.85
    },
    {
      "type": "fill",
      "label": "Step breath",
      "enabled": true,
      "palette": ["#ffffff"],
      "spread": "solid",
      "repeat": 1,
      "offset": 0,
      "scroll": 0,
      "brightness": { "source": "stompFade", "min": 0.68, "max": 1, "fadeMs": 900 },
      "blend": "multiply",
      "opacity": 1
    }
  ]
}
