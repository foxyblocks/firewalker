{
  "format": "firewalker-recipe",
  "version": 2,
  "name": "cat-peek",
  "description": "Stripes flow up both sides into a dark face at the toe, where two yellow eyes drift and blink on their own. A stomp flashes the fur pink.",
  "layers": [
    {
      "type": "fill",
      "label": "Stripes",
      "enabled": true,
      "palette": ["#6a00ff", "#6a00ff", "#6a00ff", "#ff1f8f", "#ff1f8f", "#ff1f8f"],
      "spread": "foot",
      "repeat": 3,
      "offset": 0,
      "scroll": { "source": "wave", "min": -0.1, "max": -0.7, "periodMs": 5200 },
      "brightness": 1,
      "blend": "over",
      "opacity": 1
    },
    {
      "type": "flash",
      "label": "Startle",
      "enabled": true,
      "trigger": "any",
      "palette": ["#ff9ad0", "#ff1f8f"],
      "fadeMs": 350,
      "brightness": { "source": "stompStrength", "min": 0.3, "max": 0.8 },
      "blend": "add",
      "opacity": 1
    },
    {
      "type": "band",
      "label": "Face",
      "enabled": true,
      "position": 0,
      "width": 0.75,
      "blend": "multiply",
      "opacity": 1
    },
    {
      "type": "fill",
      "label": "Eyes",
      "enabled": true,
      "palette": ["#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#000000", "#ffd000", "#000000"],
      "spread": "foot",
      "repeat": 0.98,
      "offset": { "source": "wave", "min": 0, "max": 0.045, "periodMs": 7300 },
      "scroll": 0,
      "brightness": 1,
      "blend": "add",
      "opacity": 1
    },
    {
      "type": "fill",
      "label": "Eyelid",
      "enabled": true,
      "palette": ["#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#ffffff", "#000000", "#000000"],
      "spread": "foot",
      "repeat": 0.7,
      "offset": { "source": "wave", "min": 0, "max": 0.285, "periodMs": 4600 },
      "scroll": 0,
      "brightness": 1,
      "blend": "multiply",
      "opacity": 1
    }
  ]
}
