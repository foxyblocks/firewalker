{
  "format": "firewalker-recipe",
  "version": 1,
  "name": "heat-inferno",
  "description": "The heat map in the reference photo's colors: dark blue through purple and magenta to gold and pale yellow at the down end. A stomp is a burst of heat that cools back through the ramp.",
  "layers": [
    {
      "type": "fill",
      "label": "Temperature",
      "enabled": true,
      "palette": ["#f8de5a", "#f66501", "#e22504", "#a80d13", "#640425", "#32022b", "#130130", "#060229", "#040541", "#060229", "#130130", "#32022b", "#640425", "#a80d13", "#e22504", "#f66501"],
      "spread": "foot",
      "repeat": 0.5,
      "offset": { "source": "tilt", "min": 0, "max": 0.5 },
      "scroll": 0,
      "brightness": 1,
      "blend": "over",
      "opacity": 1
    },
    {
      "type": "flash",
      "label": "Heat burst",
      "enabled": true,
      "trigger": "any",
      "palette": ["#f8de5a", "#f66501", "#e22504", "#a80d13", "#640425"],
      "fadeMs": 700,
      "brightness": 1,
      "blend": "over",
      "opacity": 1
    }
  ]
}
