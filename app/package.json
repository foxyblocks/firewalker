{
  "name": "firewalker-remote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:native": "vite --mode native",
    "build": "tsc --noEmit && vite build",
    "build:native": "vite build --mode native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "bun run build:native && cap sync ios",
    "ios": "bun run build:native && cap sync ios && cap run ios",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@storybook/react-vite": "10.6.6",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-serial": "^1.0.9",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.2.1",
    "storybook": "10.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
